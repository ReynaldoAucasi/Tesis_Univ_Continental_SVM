        # Stemming
        stemmed_words = [self.stemmer.stem(word) for word in words]
        
        return ' '.join(stemmed_words)
    
    def fit(self, X_text, y):
        """Entrena el modelo completo"""
        # Preprocesar textos
        processed_texts = [self.preprocess_text(text) for text in X_text]
        
        # Vectorizar textos
        X_tfidf = self.vectorizer.fit_transform(processed_texts)
        
        # Codificar etiquetas
        y_encoded = self.label_encoder.fit_transform(y)
        
        # Entrenar modelo SVM
        self.model.fit(X_tfidf, y_encoded)
        
        return self
    
    def predict(self, X_text):
        """Realiza predicciones para nuevos tickets"""
        # Preprocesar textos
        processed_texts = [self.preprocess_text(text) for text in X_text]
        
        # Vectorizar textos
        X_tfidf = self.vectorizer.transform(processed_texts)
        
        # Realizar predicción
        y_pred_encoded = self.model.predict(X_tfidf)
        
        # Decodificar etiquetas
        return self.label_encoder.inverse_transform(y_pred_encoded)
    
    def predict_proba(self, X_text):
        """Obtiene probabilidades de predicción"""
        processed_texts = [self.preprocess_text(text) for text in X_text]
        X_tfidf = self.vectorizer.transform(processed_texts)
        return self.model.predict_proba(X_tfidf)

# Aplicación
def main():
# Leer y procesar los datos
    df = pd.read_csv('dataset/Dataset_modelo.csv', encoding='latin-1',sep=';')
    
    # Dividir datos en entrenamiento y prueba
    X_train, X_test, y_train, y_test = train_test_split(
        df['DESCRIPCION'],
        df['GRUPO_ASIGNADO'],
        test_size=0.2,
        random_state=42
    )
    
    # Crear y entrenar el clasificador
    classifier = TicketClassifier()
    classifier.fit(X_train, y_train)
    
    # Realizar predicciones
    y_pred = classifier.predict(X_test)
    
    # Evaluar el modelo
    print("\nReporte de Clasificación:")
    print(classification_report(y_test, y_pred))
    
    # Ejemplo de predicción para un nuevo ticket
    nuevo_ticket = ["Se requiere acceder a equipo remoto"]
    grupo_predicho = classifier.predict([nuevo_ticket])
    probabilidades = classifier.predict_proba([nuevo_ticket])
    
    print("\nPredicción para nuevo ticket:")
    print(f"Grupo asignado: {grupo_predicho[0]}")
    print("\nProbabilidades por grupo:")
    for grupo, prob in zip(classifier.label_encoder.classes_, probabilidades[0]):
        print(f"{grupo}: {prob:.2f}")

if __name__ == "__main__":
    main()
