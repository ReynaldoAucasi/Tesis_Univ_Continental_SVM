import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Configuración básica de visualización
plt.rcParams['figure.figsize'] = (12, 6)
sns.set_theme()  # Usa el tema por defecto de seaborn

# Cargar los datos
df = pd.read_csv('dataset/Dataset_modelo.csv', encoding='latin-1',sep=';')

def realizar_eda(df):
    # 1. Información general del dataset
    print("=== Información General del Dataset ===")
    print("\nDimensiones del dataset:", df.shape)
    print("\nColumnas del dataset:", df.columns.tolist())
    print("\nInformación del dataset:")
    print(df.info())
    
    # 2. Análisis de valores únicos por columna
    print("\n=== Valores únicos por columna ===")
    for columna in df.columns:
        print(f"\n{columna}:")
        print(df[columna].value_counts())
        
    # 3. Visualizaciones
    
    # 3.1 Distribución de tipos de tipo
    plt.figure(figsize=(10, 6))
    sns.countplot(data=df, y='TIPO')
    plt.title('Distribución de Tipos de Incidentes')
    plt.tight_layout()
    plt.show()
    
    # 3.2 Distribución de tipos de incidentes
    plt.figure(figsize=(10, 6))
    sns.countplot(data=df, y='SERVICIO')
    plt.title('Distribución de Tipos de Servicios')
    plt.tight_layout()
    plt.show()
    
    # 3.3 Distribución de servicios
    plt.figure(figsize=(12, 6))
    sns.countplot(data=df, y='CATEGORIA')
    plt.title('Distribución de categorias')
    plt.tight_layout()
    plt.show()
    
    # 3.4 Distribución por grupo asignado
    plt.figure(figsize=(10, 6))
    sns.countplot(data=df, y='GRUPO_ASIGNADO')
    plt.title('Distribución por Grupo Asignado')
    plt.tight_layout()
    plt.show()
# Ejecutar el análisis
resumen_estadistico = realizar_eda(df)
print("\n=== Resumen Estadístico ===")
print(resumen_estadistico)
